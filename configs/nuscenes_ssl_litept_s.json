{
  "seed": 42,
  "device": "cuda",
  "total_steps": 351600,
  "batch_size": 16,
  "num_workers": 8,
  "amp": "float16",
  "gradient_clip": 3.0,
  "output_dir": "/runs/sonata_lite",
  "log_every": 10,
  "save_every": 250,
  "wandb": {
    "enabled": true,
    "project": "sonata-lite",
    "mode": "online",
    "log_every": 10
  },
  "dataset": {
    "type": "NuScenesSSLDataset",
    "dataroot": "~/nuScenes",
    "version": "v1.0-trainval",
    "split": "train",
    "seed": 42,
    "augmentation": {
      "type": "NuScenesSSLViews",
      "grid_size": 0.1,
      "global_view_num": 2,
      "local_view_num": 4,
      "max_size": 16384,
      "mask_schedule": {
        "type": "MaskSchedule",
        "total_steps": 351600,
        "mask_size_start": 0.1,
        "mask_size_base": 0.4,
        "mask_ratio_start": 0.3,
        "mask_ratio_base": 0.7,
        "warmup_ratio": 0.05
      }
    }
  },
  "model": {
    "type": "SSLModel",
    "backbone": {
      "type": "LitePT-v1",
      "in_channels": 4,
      "enc_mode": true,
      "mask_token": true,
      "enable_flash": true,
      "drop_path": 0.3
    },
    "head_in_channels": 900,
    "backbone_amp": true,
    "head_hidden_channels": 4096,
    "head_embed_channels": 256,
    "head_num_prototypes": 4096,
    "up_cast_level": 2,
    "num_global_view": 2,
    "num_local_view": 4,
    "match_max_r": 0.32,
    "student_temp": 0.1,
    "mask_loss_weight": 0.25,
    "roll_mask_loss_weight": 0.25,
    "unmask_loss_weight": 0.5,
    "teacher_custom": {
      "drop_path": 0.0
    }
  },
  "optimizer": {
    "type": "AdamW",
    "lr": 0.0006666666666666666,
    "weight_decay": 0.04,
    "layer_decay": 0.9
  },
  "lr_schedule": {
    "type": "OneCycleLR",
    "pct_start": 0.05,
    "anneal_strategy": "cos",
    "div_factor": 10.0,
    "final_div_factor": 1000.0
  },
  "teacher_temperature": {
    "start_value": 0.04,
    "base_value": 0.07,
    "warmup_ratio": 0.05
  },
  "teacher_momentum": {
    "base_value": 0.994,
    "final_value": 1.0
  },
  "prefetch_factor": 1,
  "drop_last": true,
  "weight_decay_schedule": {
    "final_value": 0.2,
    "warmup_ratio": 0.0
  }
}
